FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ARG NEXT_PUBLIC_WS_TICKERS_URL=ws://localhost:8000/ws/tickers
ARG NEXT_PUBLIC_WS_TRADES_URL=ws://localhost:8000/ws/trades
ARG NEXT_PUBLIC_WS_KLINES_URL=ws://localhost:8000/ws/klines
ARG NEXT_PUBLIC_WS_ORDERBOOKS_URL=ws://localhost:8000/ws/orderbooks

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_WS_TICKERS_URL=$NEXT_PUBLIC_WS_TICKERS_URL
ENV NEXT_PUBLIC_WS_TRADES_URL=$NEXT_PUBLIC_WS_TRADES_URL
ENV NEXT_PUBLIC_WS_KLINES_URL=$NEXT_PUBLIC_WS_KLINES_URL
ENV NEXT_PUBLIC_WS_ORDERBOOKS_URL=$NEXT_PUBLIC_WS_ORDERBOOKS_URL

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
