BYBIT_WS_URL=wss://stream.bybit.com/v5/public/spot
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BYBIT_HTTP_URL=https://api.bybit.com
BINANCE_HTTP_URL=https://api.binance.com
ENABLE_BYBIT=true
ENABLE_BINANCE=true
SOURCES=bybit,binance
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
REDIS_URL=redis://redis:6379/0
TICKER_CHANNEL=ticker_updates
TICKER_KEY_PREFIX=ticker
TRADE_CHANNEL=trade_updates
TRADE_KEY_PREFIX=trade
ORDERBOOK_CHANNEL=orderbook_updates
ORDERBOOK_KEY_PREFIX=orderbook
ORDERBOOK_LEVELS=20
BYBIT_ORDERBOOK_TOPIC_DEPTH=50
BINANCE_ORDERBOOK_STREAM_LEVELS=20
BYBIT_ORDERBOOK_HTTP_FALLBACK_SECONDS=2.5
KLINE_CHANNEL=kline_updates
KLINE_KEY_PREFIX=kline
KLINE_HISTORY_KEY_PREFIX=kline_history
KLINE_HISTORY_LIMIT=1000
KLINE_INTERVALS=1m,5m,15m,1h
BYBIT_KLINE_TOPIC_INTERVALS=1,5,15,60
RECONNECT_DELAY_SECONDS=3
INGESTER_METRICS_PORT=9108
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_PORT=8000
CORS_ORIGINS=http://localhost:3110,http://localhost:3000
FRONTEND_PORT=3110
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
REDIS_PUBLIC_PORT=6390
WS_HEARTBEAT_SECONDS=15
KLINE_HISTORY_DEFAULT_LIMIT=300
